<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">
        <Sequence name="SwapRoutine">
            
            <RetryUntilSuccessful num_attempts="5">
                <Action ID="GetCubesPoses" cube1_pose="{cube1_pose}" cube2_pose="{cube2_pose}" settling_time="3.0"/>
            </RetryUntilSuccessful>

            <Action ID="GoHome"/>

            <Fallback name="SwapWithRecovery">
                <Sequence name="SwapSteps">
                    <Action ID="MoveCube" from="0.0; -0.60; 0.5; 1.0; 0.0; 0.0; 0.0" to="0.5; -0.1; 0.5; 1.0; 0.0; 0.0; 0.0" use_waypoint="true" waypoint_pose="0.0; -0.2; 0.5; 0.0; -0.3827; 0.0; 0.9239" waypoint_wait_time="2.0"/>
                    <Action ID="MoveCube" from="0.6; 0.00; 0.5; 1.0; 0.0; 0.0; 0.0" to="0.0; -0.60; 0.5; 1.0; 0.0; 0.0; 0.0" use_waypoint="true" waypoint_pose="0.0; -0.2; 0.5; 0.0; -0.3827; 0.0; 0.9239" waypoint_wait_time="2.0"/>
                    <Action ID="MoveCube" from="0.5; -0.1; 0.5; 1.0; 0.0; 0.0; 0.0" to="0.6; 0.00; 0.5; 1.0; 0.0; 0.0; 0.0" use_waypoint="false"/>
                </Sequence>

                <Sequence name="RecoveryLogic">
                    <Action ID="GoHome"/>
                    <AlwaysFailure/>
                </Sequence>
            </Fallback>

            <Action ID="GoHome"/>
        </Sequence>
    </BehaviorTree>
</root>


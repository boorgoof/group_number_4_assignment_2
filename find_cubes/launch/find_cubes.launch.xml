<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true" />
  <arg name="initial_delay" default="0.0" />

  <include file="$(find-pkg-share find_cubes)/launch/camera_36h11.launch.yml" />

  <node pkg="find_cubes" exec="find_cubes_nodes" name="find_cubes_position_node" output="screen"
    launch-prefix="bash -c 'sleep $(var initial_delay); $0 $@' ">
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
   
</launch>